{
  "name": "next-img-docs",
  "scripts": {
    "dev": "next dev",
    "build": "next build && touch out/.nojekyll",
    "build:webpack": "next build --webpack && touch out/.nojekyll",
    "clean": "rm -rf .next && rm -rf out",
    "start": "next dev",
    "release:docs": "npm run clean && npm run build && gh-pages -d out -t"
  },
  "dependencies": {
    "js-beautify": "^1.15.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "next": "^16.3.1"
  }
}
