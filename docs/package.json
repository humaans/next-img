{
  "name": "next-img-docs",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build && touch out/.nojekyll",
    "clean": "rm -rf .next && rm -rf out",
    "start": "next dev --webpack",
    "release:docs": "npm run clean && npm run build && gh-pages -d out -t"
  },
  "dependencies": {
    "js-beautify": "^1.15.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "next": "^16.2.11"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.3",
    "brace-expansion": "^5.0.8"
  }
}
