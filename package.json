  "bin": {
    "next-img": "bin/next-img"
  },
  "files": [
    "bin/**/*",
    "lib/**/*",
    "index.js",
    "plugin.js",
    "loader.js",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "oxlint && ava",
    "test:integration": "npm run test:integration:turbopack && npm run test:integration:webpack",
