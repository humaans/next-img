    "test:integration:webpack": "next build test/fixtures/next-app --webpack",
    "release": "np"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "debug": "^4.4.3",
    "deepmerge": "^4.3.1",
    "kleur": "^4.1.5",
    "loader-utils": "^3.3.1",
    "mkdirp": "^3.0.1",
    "qs": "^6.15.3",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "ava": "^8.0.1",
    "next": "^16.3.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "ava": {
    "files": [
      "./test/**/*.test.js"
    ],
    "require": [
      "./test/setup.js",
      "@swc-node/register"
